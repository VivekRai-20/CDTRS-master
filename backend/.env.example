# ==============================================================================
# CDTRS FastAPI Backend - Environment Configuration Template
# PZ_26/08 - Environment settings template for CDTRS V2 Backend
# Copy this file to .env in backend/ directory:
#   PowerShell / CMD: copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
# Default local PostgreSQL credentials:
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:fctd@localhost:5432/cdtrs

# ------------------------------------------------------------------------------
# 2. SERVER NETWORK BINDING
# HOST=0.0.0.0 allows client PCs on the office LAN / WiFi network to connect
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 3. SECURITY & TOKEN SETTINGS
# ------------------------------------------------------------------------------
SECRET_KEY=cdtrs-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. SERVER ATTACHMENT STORAGE & LIMITS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# ------------------------------------------------------------------------------
# 5. CORS ALLOWED ORIGINS (* allows all frontend clients)
# ------------------------------------------------------------------------------
CORS_ORIGINS=*

# ==============================================================================
# 6. MICROSOFT OUTLOOK / GRAPH API CONFIGURATION
# PZ_26/08 - Dual-Mode Support:
# ==============================================================================
#
# MODE A: PERSONAL TESTING (@outlook.com / @hotmail.com)
# When testing on a new PC or testing account, set:
#   OUTLOOK_AUTH_MODE=personal
#   OUTLOOK_MAILBOX=your_email@outlook.com
#   (Then run: python backend/mail/auth_personal.py once, or include .token_cache.json)
#
OUTLOOK_AUTH_MODE=personal
OUTLOOK_MAILBOX=pratiksha.cdtrs@outlook.com
OUTLOOK_FOLDER=Inbox

# MODE B: ENTERPRISE / ORGANIZATIONAL DEPLOYMENT (Microsoft 365 / Azure Entra ID)
# When deploying for the real office / government intranet, set:
#   OUTLOOK_AUTH_MODE=organizational
#   OUTLOOK_TENANT_ID=<your-azure-tenant-id>
#   OUTLOOK_CLIENT_ID=<your-azure-app-client-id>
#   OUTLOOK_CLIENT_SECRET=<your-azure-app-client-secret>
#   OUTLOOK_MAILBOX=ds.office@cdtrs.gov.in
#
# OUTLOOK_TENANT_ID=00000000-0000-0000-0000-000000000000
# OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
# OUTLOOK_CLIENT_SECRET=your_azure_client_secret_here


