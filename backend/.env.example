# ==============================================================================
# CDTRS backend settings
# Copy this file to backend\.env and fill it in:   copy .env.example .env
# backend\.env holds passwords - it is never committed to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
#    postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/cdtrs

# ------------------------------------------------------------------------------
# 2. SERVER (used by run_server.py / start_backend.bat)
#    HOST=0.0.0.0   other PCs on the LAN can connect (allow the port in the
#                   Windows firewall - see Intranet_testing.md)
#    HOST=127.0.0.1 only this PC
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 3. SECURITY
#    SECRET_KEY signs login tokens.  Use a long random value, e.g. the output of
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#    Changing it logs everybody out.
# ------------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. FILE STORAGE
#    UPLOAD_DIR is relative to the backend folder.  MAX_FILE_SIZE in bytes (20 MB).
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# ------------------------------------------------------------------------------
# 5. CORS - "*" or a comma-separated list of allowed browser origins.
#    The desktop application does not need it.
# ------------------------------------------------------------------------------
CORS_ORIGINS=*

# ==============================================================================
# 6. MAIL (optional - leave commented out until a mailbox is available)
#    MAIL_CHANNEL chooses the system:  outlook  |  intranet  |  off (no mail at all)
#    See OUTLOOK_INTEGRATION_GUIDE.md.
# ==============================================================================
# MAIL_CHANNEL=intranet

# --- Mode A: Microsoft Outlook / Microsoft 365 (Graph API) -------------------
# Personal @outlook.com / @hotmail.com mailbox (sign in once with
#   python mail/auth_personal.py):
# OUTLOOK_AUTH_MODE=personal
# OUTLOOK_MAILBOX=someone@outlook.com
# OUTLOOK_FOLDER=Inbox
#
# Organisation (Microsoft 365 / Entra ID app registration):
# OUTLOOK_AUTH_MODE=organizational
# OUTLOOK_TENANT_ID=00000000-0000-0000-0000-000000000000
# OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
# OUTLOOK_CLIENT_SECRET=your-client-secret
# OUTLOOK_MAILBOX=ds.office@your-domain.gov.in

# --- Mode B: office intranet mail server (IMAP in, SMTP out) -----------------
# Incoming: the DS mailbox that receives documents
# INTRANET_IMAP_HOST=192.168.1.100
# INTRANET_IMAP_PORT=993
# INTRANET_IMAP_SECURITY=ssl          # ssl | starttls | plain
# INTRANET_IMAP_AUTH=password
# DS_MAIL_USER=ds_office@intranet.gov.in
# DS_MAIL_PASS=
# IMAP_TIMEOUT=20
#
# Outgoing: the CDTRS mailbox that sends notifications
# INTRANET_SMTP_HOST=192.168.1.100
# INTRANET_SMTP_PORT=587
# INTRANET_SMTP_SECURITY=starttls     # ssl | starttls | plain
# INTRANET_SMTP_AUTH=password
# CDTRS_MAIL_USER=cdtrs@intranet.gov.in
# CDTRS_MAIL_PASS=
# CDTRS_SENDER_EMAIL=cdtrs@intranet.gov.in
# CDTRS_SENDER_NAME=CDTRS
#
# true = accept the office mail server's self-signed certificate
# INTRANET_ALLOW_SELFSIGNED=true

# --- Testing -------------------------------------------------------------------
# Send every notification to this one address instead of the real recipients:
# OVERRIDE_TEST_RECIPIENT_EMAIL=
# Default recipient for  python tests\test_intranet_mail.py --send
# TEST_MAIL_RECIPIENT=
