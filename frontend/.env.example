# ==============================================================================
# CDTRS desktop application settings
# Copy this file to frontend\.env:   copy .env.example .env
# ==============================================================================

# Address of the backend (see backend\.env HOST / PORT):
#   same PC:          http://127.0.0.1:8000/api/v1
#   server on the LAN: http://192.168.1.50:8000/api/v1   (the server PC's IP address)
CDTRS_API_URL=http://127.0.0.1:8000/api/v1

# Seconds to wait for the backend before reporting an error
CDTRS_API_TIMEOUT=15.0

CDTRS_APP_NAME=CDTRS
CDTRS_APP_VERSION=2.0.0
