# ==============================================================================
# CDTRS Desktop Frontend - Environment Configuration Template
# Copy this file to .env in the frontend/ directory: copy .env.example .env
# ==============================================================================

# Data Source Mode: 'api' to connect to live FastAPI backend, 'mock' for local in-memory demo
CDTRS_DATA_SOURCE=api

# Backend API Base URL
# - Local PC (Default): http://127.0.0.1:8000/api/v1
# - Another PC on LAN:  http://192.168.1.50:8000/api/v1 (Replace with Server PC's Local IP)
# - Cloud Deployment:   https://your-domain.com/api/v1
CDTRS_API_URL=http://127.0.0.1:8000/api/v1

# API Network Request Timeout in seconds
CDTRS_API_TIMEOUT=15.0

# Application Window Title and Version
CDTRS_APP_NAME=CDTRS
CDTRS_APP_VERSION=2.0.0
