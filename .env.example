# ==============================================================================
# CDTRS - Configuration & Environment Settings (.env)
# ==============================================================================

# ==============================================================================
# DATABASE
# ==============================================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdtrs_db
# DATABASE_URL=sqlite:///./cdtrs.db


# ==============================================================================
# FILE STORAGE
# ==============================================================================

UPLOAD_DIR=./uploads


# ==============================================================================
# SECURITY
# ==============================================================================

JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==============================================================================
# MAIL INTEGRATION MODE
# ==============================================================================
#
# Select the active mail system:
#
#   outlook  -> Microsoft Graph API / Outlook
#   intranet -> Office LAN IMAP + SMTP
#
# Both configurations are kept below.
# Change ONLY this value when switching environments.
#
# ==============================================================================
MAIL_CHANNEL=outlook


# ==============================================================================
# MODE A - MICROSOFT GRAPH / OUTLOOK
# ==============================================================================
#
# Used when:
#     MAIL_CHANNEL=outlook
#
# For personal Outlook / Hotmail:
#     OUTLOOK_TENANT_ID=consumers
#
# For Microsoft 365 organizational account:
#     OUTLOOK_TENANT_ID=<your-tenant-id>
#
# OAuth/device-code authentication can be used depending on the
# current outlook_auth.py configuration.
#
# ==============================================================================

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_MAILBOX=pratiksha@outlook.com


# ==============================================================================
# MODE B - OFFICE INTRANET MAIL
# ==============================================================================
#
# Used when:
#     MAIL_CHANNEL=intranet
#
# Architecture:
#
#     DS MAILBOX
#          |
#         IMAP
#          |
#        CDTRS
#
#     CDTRS MAILBOX
#          |
#         SMTP
#          |
#     Director / HOD / Employee
#
# The DS mailbox and CDTRS outgoing mailbox are intentionally separate.
#
# ==============================================================================


# ------------------------------------------------------------------------------
# INCOMING - DS MAILBOX / IMAP
# ------------------------------------------------------------------------------

INTRANET_IMAP_HOST=192.168.1.100
INTRANET_IMAP_PORT=993

# Options:
#   ssl
#   starttls
#   plain
INTRANET_IMAP_SECURITY=ssl

# Authentication:
#   password
INTRANET_IMAP_AUTH=password

# DS mailbox credentials
DS_MAIL_USER=ds_office@intranet.gov.in
DS_MAIL_PASS=your_ds_mail_password


# ------------------------------------------------------------------------------
# OUTGOING - CDTRS MAILBOX / SMTP
# ------------------------------------------------------------------------------

INTRANET_SMTP_HOST=192.168.1.100
INTRANET_SMTP_PORT=587

# Options:
#   ssl
#   starttls
#   plain
INTRANET_SMTP_SECURITY=starttls

# Authentication:
#   password
INTRANET_SMTP_AUTH=password

# CDTRS application mailbox credentials
CDTRS_MAIL_USER=cdtrs@intranet.gov.in
CDTRS_MAIL_PASS=your_cdtrs_mail_password

# Sender shown on outgoing CDTRS emails
CDTRS_SENDER_EMAIL=cdtrs@intranet.gov.in
CDTRS_SENDER_NAME=CDTRS


# ------------------------------------------------------------------------------
# SSL CERTIFICATE
# ------------------------------------------------------------------------------

# true  -> allow self-signed office mail-server certificate
# false -> require normal certificate validation
INTRANET_ALLOW_SELFSIGNED=true


# ==============================================================================
# TEST / DEMO SAFETY
# ==============================================================================
#
# Leave EMPTY for actual user recipients.
#
# If set to an email address, workflow emails may be redirected there
# depending on the MailService implementation.
#
# ==============================================================================

OVERRIDE_TEST_RECIPIENT_EMAIL=